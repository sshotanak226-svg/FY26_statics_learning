            "width": 1455.64453125,
            "height": 56.014617919921875
          }
        },
        {
          "tex": "\n\\theta_*\\in\\Theta_0,\\quad\\text{正則条件}\n\\quad\\Longrightarrow\\quad\n-2\\log\\Lambda\\xrightarrow{d}\\chi^2_q=\\chi^2_{m-k}.\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
