            "bottom": 512.5,
            "width": 1455.64453125,
            "height": 100.06597900390625
          }
        },
        {
          "tex": "\n\\bigl(\\mathcal I^{-1}\\bigr)_{\\psi\\psi}\n=(C-B^\\top A^{-1}B)^{-1}=J^{-1}.\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
