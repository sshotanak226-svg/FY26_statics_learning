            "top": 450.6875,
            "bottom": 565.767333984375,
            "width": 1455.64453125,
            "height": 115.079833984375
          }
        },
        {
          "tex": "\n\\min_d Q(d)=\\delta^\\top J\\delta\n\\quad\\Longrightarrow\\quad\n-2\\log\\Lambda=n\\delta^\\top J\\delta+o_p(1).\n",
          "overflow": false,
          "box": {
