    {
      "title": "A15　ベクトルのスコア方程式を展開する",
      "id": "appendix-multi-score-expansion",
      "clipping": [],
      "math": [
        {
          "tex": "\n\\boldsymbol0=U_n(\\theta_*)+\n\\left[\\int_0^1H_n\\!\\left(\\theta_*+t(\\hat\\theta-\\theta_*)\\right)dt\\right]\n(\\hat\\theta-\\theta_*).\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
            "right": 1588.844482421875,
            "top": 422.0333251953125,
            "bottom": 504.2583312988281,
            "width": 1455.64453125,
            "height": 82.22500610351562
          }
        },
        {
          "tex": "\nM_n:=-\\frac1n\\int_0^1H_n\\!\\left(\\theta_*+t(\\hat\\theta-\\theta_*)\\right)dt.\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
            "right": 1588.844482421875,
            "top": 592.5687255859375,
            "bottom": 673.5479736328125,
