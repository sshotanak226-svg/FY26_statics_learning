      "clipping": [],
      "math": [
        {
          "tex": "\nZ_n:=\\sqrt n\\,J^{1/2}\\delta\n\\xrightarrow{d}Z\\sim N_q(\\boldsymbol0,\\mathbf I_q).\n",
