        {
          "tex": "\n\\sqrt n\\,\\delta=\\sqrt n(\\hat\\psi-\\psi_0)\n\\xrightarrow{d}N_q(\\boldsymbol0,J^{-1}).\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
            "right": 1588.844482421875,
