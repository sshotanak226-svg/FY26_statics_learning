    {
      "title": "A18　自由なk成分と固定するq成分を分ける",
      "id": "appendix-multi-partition",
      "clipping": [],
      "math": [
        {
          "tex": "\n\\mathcal I=\\begin{pmatrix}A&B\\\\B^\\top&C\\end{pmatrix},\n\\qquad A\\in\\mathbb R^{k\\times k},\\quad\nB\\in\\mathbb R^{k\\times q},\\quad C\\in\\mathbb R^{q\\times q}.\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
            "right": 1588.844482421875,
            "top": 456.3576354980469,
            "bottom": 535.16455078125,
            "width": 1455.64453125,
            "height": 78.80691528320312
          }
        },
        {
          "tex": "\nQ(d):=\\begin{pmatrix}d\\\\-\\delta\\end{pmatrix}^{\\!\\top}\n\\mathcal I\\begin{pmatrix}d\\\\-\\delta\\end{pmatrix}\n=d^\\top A d-2d^\\top B\\delta+\\delta^\\top C\\delta.\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
            "right": 1588.844482421875,
            "top": 623.4749755859375,
            "bottom": 709.7889404296875,
            "width": 1455.64453125,
            "height": 86.31396484375
