          "tex": "\n-2\\log\\Lambda=Z_n^\\top Z_n+o_p(1)\n\\quad\\Longrightarrow\\quad\n-2\\log\\Lambda\\xrightarrow{d}\n\\sum_{j=1}^{q}Z_j^2\\sim\\chi^2_q.\n",
