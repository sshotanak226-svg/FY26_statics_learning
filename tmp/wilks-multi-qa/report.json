    {
      "title": "A20　残るq成分の共分散を求める",
      "id": "appendix-multi-covariance",
      "clipping": [],
      "math": [
        {
          "tex": "\n\\left.\\begin{aligned}\nAu+Bv&=\\boldsymbol0,\\\\\nB^\\top u+Cv&=w\n\\end{aligned}\\right\\}\n\\quad\\Longrightarrow\\quad\nu=-A^{-1}Bv,\\qquad Jv=w.\n",
          "overflow": false,
