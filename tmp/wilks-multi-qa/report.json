    {
      "title": "A19　平方完成で自由な成分を取り除く",
      "id": "appendix-multi-square",
      "clipping": [],
      "math": [
        {
          "tex": "\n\\begin{aligned}\nQ(d)&=(d-A^{-1}B\\delta)^\\top A(d-A^{-1}B\\delta)\n+\\delta^\\top J\\delta,\\\\[4pt]\nJ&:=C-B^\\top A^{-1}B.\n\\end{aligned}\n",
          "overflow": false,
          "box": {
