    {
      "title": "A13　帰無仮説の下でも動かせる母数",
      "id": "appendix-multi-estimators",
      "clipping": [],
      "math": [
        {
          "tex": "\n\\theta=\\begin{pmatrix}\\eta\\\\\\psi\\end{pmatrix},\n\\quad\\eta\\in\\mathbb R^k,\\quad\\psi\\in\\mathbb R^q,\n\\qquad H_0:\\psi=\\psi_0.\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
            "right": 1588.844482421875,
            "top": 417.14581298828125,
            "bottom": 495.6492919921875,
            "width": 1455.64453125,
            "height": 78.50347900390625
          }
        },
        {
          "tex": "\n\\hat\\theta=\\begin{pmatrix}\\hat\\eta\\\\\\hat\\psi\\end{pmatrix}\n=\\underset{\\theta\\in\\Theta}{\\arg\\max}\\,\\ell(\\theta),\n\\qquad\n\\tilde\\theta=\\begin{pmatrix}\\tilde\\eta\\\\\\psi_0\\end{pmatrix},\n\\quad\\tilde\\eta=\\underset{\\eta}{\\arg\\max}\\,\\ell(\\eta,\\psi_0).\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
            "right": 1588.844482421875,
            "top": 583.959716796875,
            "bottom": 667.0152587890625,
            "width": 1455.64453125,
            "height": 83.0555419921875
          }
        },
        {
          "tex": "\n\\Lambda=\\frac{L(\\tilde\\theta\\mid\\boldsymbol X)}{L(\\hat\\theta\\mid\\boldsymbol X)},\n\\qquad -2\\log\\Lambda=2\\{\\ell(\\hat\\theta)-\\ell(\\tilde\\theta)\\}.\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
            "right": 1588.844482421875,
            "top": 707.9041748046875,
            "bottom": 796.4222412109375,
            "width": 1455.64453125,
            "height": 88.51806640625
          }
        }
      ],
      "style": {
        "article": "slide theme-proof",
        "font": "700 32px / 40px \"Yu Gothic\", 游ゴシック, Meiryo, メイリオ, sans-serif",
        "position": "start"
      },
      "counter": "Appendix 13"
    },
    {
      "title": "A14　スコアと曲率をベクトル・行列にする",
      "id": "appendix-multi-information",
      "clipping": [],
      "math": [
        {
          "tex": "\nU_n(\\theta):=\\nabla\\ell(\\theta),\n\\qquad H_n(\\theta):=\\nabla^2\\ell(\\theta).\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
            "right": 1588.844482421875,
            "top": 482.9034729003906,
            "bottom": 538.9180908203125,
            "width": 1455.64453125,
            "height": 56.014617919921875
          }
        },
        {
          "tex": "\nE_{\\theta_*}[s_i(\\theta_*)]=\\boldsymbol0,\n\\qquad\n\\mathcal I:=\\operatorname{Cov}_{\\theta_*}[s_i(\\theta_*)]\n=-E_{\\theta_*}[\\nabla^2\\log f(X_i\\mid\\theta_*)].\n",
          "overflow": false,
          "box": {
            "left": 133.199951171875,
            "right": 1588.844482421875,
            "top": 627.228515625,
            "bottom": 683.2430419921875,
            "width": 1455.64453125,
            "height": 56.0145263671875
