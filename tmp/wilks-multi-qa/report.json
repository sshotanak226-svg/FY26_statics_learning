            "height": 80.979248046875
          }
        },
        {
          "tex": "\n\\boldsymbol0=U_n(\\theta_*)-nM_n(\\hat\\theta-\\theta_*)\n\\quad\\Longrightarrow\\quad\n\\sqrt n(\\hat\\theta-\\theta_*)=M_n^{-1}\\frac{U_n(\\theta_*)}{\\sqrt n}.\n",
          "overflow": false,
